        <mxCell id="M5FMTD9QmsBf1sCgMCIv-401" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;each record has an id, cost, initiated date, &amp;amp; settled date [if settled].&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;and in addition , there is settled column that decides if payment is settled or not,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;there is share column that has share button for each recoed and this button forward the payment&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;to right department through email or enternal messaging system.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;then there is dowload column that has button for eah record for donwload the payment document&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;so that it shall be printed and settled physically.&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];" parent="M5FMTD9QmsBf1sCgMCIv-399" vertex="1" connectable="0">
          <mxGeometry x="0.5616" y="-5" relative="1" as="geometry">
            <mxPoint x="9" y="-4" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="M5FMTD9QmsBf1sCgMCIv-402" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#2EAD76;strokeWidth=5;" parent="1" edge="1">
